{
  "name": "dsh-mise-env",
  "version": "0.1.0",
  "description": "Reproducible mise project environments for DeepSeek Harness: inspect, prepare, and run inside the pinned toolchain.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mise",
    "environment",
    "reproducible"
  ],
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
