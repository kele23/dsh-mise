{
  "name": "dsh-mise-env",
  "version": "0.1.0",
  "description": "Reproducible mise project environments for DeepSeek Harness: inspect, prepare, and run inside the pinned toolchain.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mise",
    "environment",
    "reproducible"
  ],
  "author": "kele23",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kele23/dsh-mise.git"
  },
  "homepage": "https://github.com/kele23/dsh-mise#readme",
  "bugs": {
    "url": "https://github.com/kele23/dsh-mise/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs",
    "prepublishOnly": "node scripts/check.mjs"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
